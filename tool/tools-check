#!/bin/sh
# Every tool's name, stated once in its .pro and repeated in two places that
# cannot derive it.
#
# fmake names a program after its root translation unit, which gives the bare
# verb -- `tray` where qmake builds `qtty-tray-check`. fmake.toml carries the
# mapping and .gitignore carries the result, and NEITHER can be computed from
# the tree, so both are copies of a fact and both go stale silently.
#
# They did. The tray gate was added with neither, so `python3 fmake` built a
# program called `tray` and left it untracked at the repository root -- which
# is precisely the state the .gitignore comment above the program list was
# written to record the last time it happened. Nothing noticed until somebody
# ran fmake and read `git status`.
#
# Checked rather than remembered: this reads each tool/*/ *.pro for its
# TARGET, then requires fmake.toml to rename that directory to it and
# .gitignore to ignore it.
set -e
root=$(dirname "$0")/..
fail=0
n=0
for pro in "$root"/tool/*/*.pro; do
	[ -f "$pro" ] || continue
	dir=$(basename "$(dirname "$pro")")
	target=$(sed -n 's/^[[:space:]]*TARGET[[:space:]]*=[[:space:]]*\([^[:space:]]*\).*/\1/p' "$pro" | head -1)
	if [ -z "$target" ]; then
		echo "tools-check: $pro states no TARGET" >&2
		fail=1
		continue
	fi
	n=$((n + 1))
	# fmake.toml must rename the directory to the .pro's TARGET. A bare
	# verb that happens to match needs no stanza, so that case passes.
	if [ "$dir" != "$target" ]; then
		if ! grep -q "^\[target\.$dir\]" "$root/fmake.toml" \
		|| ! awk -v d="[target.$dir]" '
			$0 == d { found = 1; next }
			found && /^\[/ { exit }
			found && /^name[[:space:]]*=/ { print; exit }' \
			"$root/fmake.toml" | grep -q "\"$target\""; then
			echo "tools-check: fmake.toml does not rename $dir to $target," >&2
			echo "             so fmake builds it as '$dir'." >&2
			fail=1
		fi
	fi
	if ! grep -qx "/$target" "$root/.gitignore"; then
		echo "tools-check: .gitignore does not carry /$target, so an" >&2
		echo "             fmake build leaves it untracked at the root." >&2
		fail=1
	fi
done
if [ "$n" -eq 0 ]; then
	echo "tools-check: no tool/*/*.pro found, so nothing was checked -- a" >&2
	echo "             sweep over an empty list passes exactly like a real" >&2
	echo "             one, so this is a failure." >&2
	exit 1
fi
# The language standard is the same shape of fact: stated in qtty.pri for
# qmake and in fmake.toml for fmake, derivable from neither. They agreed
# only because fmake passed no -std= at all and the compiler's own default
# happened to match -- which is a property of the compiler, not of this
# project, and would drift silently the day that default moves.
qstd=$(sed -n 's/^[[:space:]]*CONFIG[[:space:]]*+=.*\(c++[0-9a-z]*\).*/\1/p' \
       "$root/qtty.pri" | head -1)
fstd=$(sed -n 's/^[[:space:]]*std[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' \
       "$root/fmake.toml" | head -1)
if [ -z "$qstd" ] || [ -z "$fstd" ]; then
	echo "tools-check: a language standard is missing -- qtty.pri says" >&2
	echo "             '$qstd', fmake.toml says '$fstd'. Neither build" >&2
	echo "             system can derive it from the other." >&2
	fail=1
elif [ "$qstd" != "$fstd" ]; then
	echo "tools-check: qtty.pri builds $qstd and fmake.toml builds $fstd." >&2
	fail=1
fi

# An include path the suite needs is the third fact of the same shape, and
# it is the one that actually broke. test/suite_router.cpp includes the
# example's header; test/test.pro says INCLUDEPATH for qmake; fmake cannot
# read a .pro and has to be told in fmake.toml. It was told about the
# defines, the standard and the tool names and not about this, so
# `fmake` exited 1 on a clean checkout while the README said it builds the
# tree -- found by another project running the line this repository
# publishes.
#
# Compared as SETS of directory names rather than textually, since the two
# files spell a path differently by construction: qmake writes
# $$QTTY_ROOT/example/chat and fmake writes it relative to the root.
qinc=$(sed -n 's|^[[:space:]]*INCLUDEPATH[[:space:]]*+=[[:space:]]*\$\$QTTY_ROOT/||p' \
       "$root/test/test.pro" | tr -d ' ' | sort -u)
finc=$(sed -n 's/^[[:space:]]*include-dirs[[:space:]]*=[[:space:]]*\[\(.*\)\].*/\1/p' \
       "$root/fmake.toml" | tr -d ' "' | tr ',' '\n' | sed '/^$/d' | sort -u)
if [ -z "$qinc" ]; then
	echo "tools-check: test/test.pro names no INCLUDEPATH under the root," >&2
	echo "             so this compared nothing. If the suite genuinely" >&2
	echo "             needs none, delete this check rather than letting" >&2
	echo "             it pass over an empty list." >&2
	fail=1
elif [ "$qinc" != "$finc" ]; then
	echo "tools-check: the suite's include paths differ between the two" >&2
	echo "             build systems. test/test.pro has:" >&2
	echo "$qinc" | sed 's/^/                 /' >&2
	echo "             fmake.toml has:" >&2
	echo "$finc" | sed 's/^/                 /' >&2
	echo "             fmake cannot read a .pro, so a path in one and not" >&2
	echo "             the other is a build that fails on a clean tree." >&2
	fail=1
fi

# -- WHICH PROGRAMS SHIP, which the two build systems decide separately and
#    which fmake had wrong in the direction that matters. `make install`
#    puts two programs in $PREFIX/bin; `fmake --explain` showed a plan of
#    SIX -- the example, a machine probe, a gate that needs a session bus,
#    and a negotiator that reports rather than does. It cost nothing while
#    nobody ran `fmake --install` here, and an ejected Makefile carries the
#    install rule with it, so `--eject make` from this tree would have put
#    all six into somebody's package.
#
#    CHECKED TWICE, and the two are not redundant. The STATIC assertion
#    below reads fmake.toml: a program the Makefile does not install must
#    say `install = false`. It needs nothing installed, runs always, and
#    is the one that fails the moment somebody adds a program and forgets.
#    The LIVE comparison after it asks fmake for its actual plan, which is
#    the authority -- a toml key is what the tree says and the plan is what
#    fmake would do.
#
#    The live one was impossible when this was written: `--explain` needs
#    the objects, so asking it from `make check` would have compiled the
#    whole tree a second time on a cold cache. fmake's session added
#    `-n --install` for exactly this (their section 297), which prints the
#    plan and builds nothing -- measured here at 2.3 s with no compile.
#
#    Its stated caveat does not bite here and is worth knowing anyway: the
#    link sets have not widened in a dry run, so furniture declared in a
#    file that joins a target only by symbol is missing from the plan. This
#    compares PROGRAMS, which are targets rather than furniture.
installed=$(sed -n 's/^INSTALLED_FILES *= *//p' "$root/Makefile" \
            | tr ' ' '\n' | sed -n 's|^usr/bin/||p' | sort -u)
if [ -z "$installed" ]; then
	echo "tools-check: the Makefile names no installed programs, so the" >&2
	echo "             comparison below had nothing to compare" >&2
	fail=1
fi
# Every program fmake builds: the four tools by their fmake.toml section
# name, plus the two the tree has no .pro for. Named here because fmake
# derives them from the tree and a .pro does not exist for either.
for t in inspect:qtty-inspect replay:qtty-replay negotiate:qtty-negotiate \
         tray:qtty-tray-check chat:chat screen-probe:screen-probe; do
	section=${t%%:*}
	program=${t#*:}
	if echo "$installed" | grep -qx "$program"; then continue; fi
	if ! awk -v d="[target.$section]" '
		$0 == d { found = 1; next }
		found && /^\[/ { exit }
		found && /^install[[:space:]]*=/ { print; exit }' \
		"$root/fmake.toml" | grep -q "false"; then
		echo "tools-check: make install does not ship $program, and" >&2
		echo "             fmake.toml does not decline it -- so" >&2
		echo "             fmake --install and an ejected Makefile would." >&2
		echo "             Say install = false under [target.$section]." >&2
		fail=1
	fi
done

# And the live plan, where fmake is to hand. Its ABSENCE is not a failure:
# fmake lives outside this tree and a contributor without it must still be
# able to run `make check`. It is announced rather than passed over, so a
# green run cannot be read as the comparison having happened.
fmake=${FMAKE:-$HOME/src/fmake/fmake}
if [ ! -f "$fmake" ]; then
	echo "tools-check: fmake is not at $fmake, so the live install plan was"
	echo "             not compared -- only fmake.toml. Set FMAKE to say"
	echo "             where it is."
else
	out=$(cd "$root" && timeout 300 python3 "$fmake" -n --install \
	          --prefix /qtty-tools-check 2>/dev/null)
	plan=$(echo "$out" | sed -n 's|^install .* /qtty-tools-check/bin/||p' \
	       | sort -u)
	# THE COUNT AND THE LINES ARE HALVES OF ONE RESULT, and reading only
	# the lines cannot tell "fmake planned nothing" from "this sed stopped
	# matching". fmake prints the count at the end of a dry run -- it was
	# added at this gate's asking -- so the two are compared: a plan with
	# files in it and no line extracted is a PARSE that broke, and saying
	# so sends the next reader to the right place. An older fmake prints no
	# count, and then this cross-check is simply absent rather than failed.
	planned=$(echo "$out" | sed -n \
	          's/^\* \([0-9][0-9]*\) file(s) would be installed.*/\1/p' \
	          | head -1)
	if [ -n "$planned" ] && [ "$planned" -gt 0 ] && [ -z "$plan" ]; then
		echo "tools-check: fmake planned $planned file(s) and this gate read" >&2
		echo "             none of them, so its parse of the install lines" >&2
		echo "             has stopped matching -- not a disagreement about" >&2
		echo "             what ships" >&2
		fail=1
	elif [ -z "$plan" ]; then
		echo "tools-check: fmake printed no install plan, so the comparison" >&2
		echo "             below would have passed against nothing" >&2
		fail=1
	elif [ "$plan" != "$installed" ]; then
		echo "tools-check: the two build systems disagree about what ships." >&2
		echo "             make install puts these in bin:" >&2
		echo "$installed" | sed 's/^/                 /' >&2
		echo "             fmake --install would put these:" >&2
		echo "$plan" | sed 's/^/                 /' >&2
		fail=1
	fi
fi

[ "$fail" -eq 0 ] || exit 1
echo "tools-check: $n tool(s) named consistently in .pro, fmake.toml and"
echo "             .gitignore, both build systems state $qstd, the suite's"
echo "             include paths agree, and both ship the same programs:"
echo "$installed" | sed 's/^/                 /'


#!/bin/sh
# A screen check: what a real terminal DRAWS, not what qtty emitted.
#
# Every graphics tier in this tree is exercised by its encoder. That leaves
# the question a user actually has -- is the picture right -- answered by
# nobody, and project.md said several times that it could not be answered
# here. It can: kitty renders under Xvfb and `import` reads the pixels back
# exactly, measured at 9600 of 9600 for a 120x80 image.
#
# Skips rather than fails where the pieces are missing, the way
# test-platforms skips without xvfb-run: a machine without kitty is not a
# machine with a broken renderer.
#
# Bounded three ways, because this starts a GUI process: a timeout around
# the whole run, kitty given a command that exits, and the Xvfb display
# taken down with it.
set -e
for need in xvfb-run kitty import python3; do
	command -v "$need" >/dev/null 2>&1 || {
		echo "screen-check: $need is absent, so nothing was drawn or read" >&2
		exit 0
	}
done
python3 -c "import PIL" 2>/dev/null || {
	echo "screen-check: python3-pil is absent, so the capture cannot be read" >&2
	exit 0
}

dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT INT TERM
w=120; h=80
python3 -c "
from PIL import Image
Image.new('RGB',($w,$h),(220,30,40)).save('$dir/in.png')"

timeout 120 xvfb-run -a -s "-screen 0 900x600x24" sh -c "
	kitty --title qtty-screen-check sh -c 'kitty +kitten icat --align left $dir/in.png; sleep 6' &
	sleep 5
	import -window root $dir/out.png
	wait" >"$dir/log" 2>&1 || true

[ -s "$dir/out.png" ] || {
	echo "screen-check: FAILED -- nothing was captured" >&2
	sed -n '1,5p' "$dir/log" >&2
	exit 1
}

# Second phase: qtty's OWN pixel path, not just the terminal's renderer.
# Skipped rather than failed when the library is not built, since a tree
# nobody has compiled is not a tree with a broken backend.
lib="${1:-build}/lib/libqtty.a"
if [ -f "$lib" ] && command -v g++ >/dev/null 2>&1 \
   && command -v pkg-config >/dev/null 2>&1; then
	if g++ -fPIC -Os -std=gnu++17 -o "$dir/probe" tool/screen-probe.cpp \
	     -I include -I . $(pkg-config --cflags Qt6Widgets) \
	     -L "${1:-build}/lib" -lqtty $(pkg-config --libs Qt6Widgets) \
	     -lutil 2>"$dir/cc"; then
		timeout 150 xvfb-run -a -s "-screen 0 900x600x24" sh -c "
			kitty sh -c 'sleep 3; QTTY_GRAPHICS=kitty $dir/probe 2>$dir/pred' &
			sleep 8
			import -window root $dir/geom.png
			wait" >>"$dir/log" 2>&1 || true
		python3 - "$dir/geom.png" "$dir/pred" <<'GEOM'
import re, sys
from PIL import Image
shot, pred = sys.argv[1], sys.argv[2]
m = re.search(r"predict left=(\d+) width=(\d+)", open(pred).read())
if not m:
	print("screen-check: FAILED -- the probe printed no prediction",
	      file=sys.stderr); sys.exit(1)
want_l, want_w = int(m.group(1)), int(m.group(2))
im = Image.open(shot).convert("RGB")
w, h = im.size
px = im.load()
xs = [x for y in range(h) for x in range(w) if px[x, y] == (40, 200, 90)]
if not xs:
	print("screen-check: FAILED -- the probe drew nothing", file=sys.stderr)
	sys.exit(1)
left, width = min(xs), max(xs) - min(xs) + 1
# One pixel of slack, and the reason is named rather than assumed: scaling
# to the terminal's cell uses a smooth transform, so the outermost column
# is blended and no longer matches the colour exactly. Both numbers are
# PRINTED, because a tolerance is only honest when the value inside it is
# visible.
ok = abs(left - want_l) <= 1 and abs(width - want_w) <= 1
print("screen-check: qtty's pixel path drew left=%d width=%d,"
	" predicted %d and %d" % (left, width, want_l, want_w),
	file=sys.stderr if not ok else sys.stdout)
sys.exit(0 if ok else 1)
GEOM
	else
		echo "screen-check: the probe did not build, so the pixel path was" >&2
		sed -n '1,3p' "$dir/cc" >&2
		exit 1
	fi
else
	echo "screen-check: no built library, so qtty's own pixel path was not" >&2
	echo "              drawn -- the terminal check above still ran" >&2
fi

python3 - "$dir/out.png" "$w" "$h" <<'PY'
import sys
from PIL import Image
shot, w, h = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
im = Image.open(shot).convert("RGB")
want = (220, 30, 40)
n = sum(1 for p in im.getdata() if p == want)
# Both directions. "Some red is on screen" is satisfied by a terminal that
# scaled the image to the whole window, and "not the whole window" by one
# that drew nothing at all.
if n == w * h:
	print("screen-check: kitty drew the image at its own size, %d px" % n)
	sys.exit(0)
print("screen-check: FAILED -- %d px of the test colour, wanted %d (%dx%d)"
	% (n, w * h, w, h), file=sys.stderr)
sys.exit(1)
PY

#!/bin/sh
# A screen check: what a real terminal DRAWS, not what qtty emitted.
#
# Every graphics tier in this tree is exercised by its encoder. That leaves
# the question a user actually has -- is the picture right -- answered by
# nobody, and project.md said several times that it could not be answered
# here. It can: kitty renders under Xvfb and `import` reads the pixels back
# exactly, measured at 9600 of 9600 for a 120x80 image.
#
# Skips rather than fails where the pieces are missing, the way
# test-platforms skips without xvfb-run: a machine without kitty is not a
# machine with a broken renderer.
#
# Bounded three ways, because this starts a GUI process: a timeout around
# the whole run, kitty given a command that exits, and the Xvfb display
# taken down with it.
set -e
for need in xvfb-run kitty import python3; do
	command -v "$need" >/dev/null 2>&1 || {
		echo "screen-check: $need is absent, so nothing was drawn or read" >&2
		exit 0
	}
done
python3 -c "import PIL" 2>/dev/null || {
	echo "screen-check: python3-pil is absent, so the capture cannot be read" >&2
	exit 0
}

dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT INT TERM
w=120; h=80
python3 -c "
from PIL import Image
Image.new('RGB',($w,$h),(220,30,40)).save('$dir/in.png')"

timeout 120 xvfb-run -a -s "-screen 0 900x600x24" sh -c "
	kitty --title qtty-screen-check sh -c 'kitty +kitten icat --align left $dir/in.png; sleep 6' &
	sleep 5
	import -window root $dir/out.png
	wait" >"$dir/log" 2>&1 || true

[ -s "$dir/out.png" ] || {
	echo "screen-check: FAILED -- nothing was captured" >&2
	sed -n '1,5p' "$dir/log" >&2
	exit 1
}

# Second phase: qtty's OWN pixel path, not just the terminal's renderer.
# Skipped rather than failed when the library is not built, since a tree
# nobody has compiled is not a tree with a broken backend.
#
# Two terminals and two protocols, because agreement between them is worth
# more than either alone: kitty over the kitty protocol, xterm over sixel.
# They share nothing but this tree -- different implementations, different
# authors, different wire formats -- so a geometry both of them draw is not
# a property of one renderer.
lib="${1:-build}/lib/libqtty.a"
if [ -f "$lib" ] && command -v g++ >/dev/null 2>&1 \
   && command -v pkg-config >/dev/null 2>&1; then
	if g++ -fPIC -Os -std=gnu++17 -o "$dir/probe" tool/screen-probe.cpp \
	     -I include -I . $(pkg-config --cflags Qt6Widgets) \
	     -L "${1:-build}/lib" -lqtty $(pkg-config --libs Qt6Widgets) \
	     -lutil 2>"$dir/cc"; then

		# Is the marker on screen yet? A tolerance, because sixel states
		# colour as three PERCENTAGES: 40,200,90 goes out as 15,78,35 and
		# comes back about 38,199,89. The kitty path is exact and passes 0.
		cat > "$dir/seen.py" <<'SEEN'
import sys
from PIL import Image
tol = int(sys.argv[2])
im = Image.open(sys.argv[1]).convert("RGB")
def near(p):
	# A negative tolerance asks for the marker by ELIMINATION rather than by
	# colour: anything that is neither the terminal's background nor its
	# foreground. The halfblocks tier draws through the terminal's own
	# palette, so its green is whatever that terminal has -- (0,205,0) in
	# xterm here -- and a colour test wide enough to admit that would admit
	# most of the screen.
	if tol < 0:
		return p != (0, 0, 0) and p != (255, 255, 255)
	return (abs(p[0] - 40) <= tol and abs(p[1] - 200) <= tol
	        and abs(p[2] - 90) <= tol)
sys.exit(0 if any(near(p) for p in im.getdata()) else 1)
SEEN

		# Captured on a CONDITION rather than after a duration. The first
		# version slept eight seconds and drew nothing on a loaded machine
		# -- a fixed wait is a guess about somebody else's build queue, and
		# this file already argues that a check which fails for the wrong
		# reason is worse than no check. It re-captures until the marker
		# appears, with a bound so it still terminates when nothing ever
		# draws.
		capture() {
			shot=$1; tol=$2; shift 2
			timeout 200 xvfb-run -a -s "-screen 0 900x600x24" sh -c "
				$* &
				n=0
				while [ \$n -lt 25 ]; do
					sleep 1
					import -window root $shot 2>/dev/null || true
					if [ -s $shot ] && python3 $dir/seen.py $shot $tol
					then break; fi
					n=\$((n + 1))
				done
				wait" >>"$dir/log" 2>&1 || true
		}

		cat > "$dir/geom.py" <<'GEOM'
import re, sys
from PIL import Image
shot, pred, tol, slack, who = sys.argv[1:6]
tol, slack = int(tol), int(slack)
# An optional CONTROL colour that must also be on the screen. Without one, a
# capture with no marker in it cannot tell a path that drew nothing from a
# run that never drew at all -- which cost three wrong readings while the
# overlay phase was being written, each of them looking like a broken
# renderer.
control = None
if len(sys.argv) > 6:
	control = tuple(int(v) for v in sys.argv[6].split(","))
m = re.search(r"predict left=(\d+) width=(\d+)", open(pred).read())
if not m:
	print("screen-check: FAILED -- %s's probe printed no prediction" % who,
	      file=sys.stderr); sys.exit(1)
want_l, want_w = int(m.group(1)), int(m.group(2))
im = Image.open(shot).convert("RGB")
w, h = im.size
px = im.load()
def near(p):
	if tol < 0:
		return p != (0, 0, 0) and p != (255, 255, 255)
	return (abs(p[0] - 40) <= tol and abs(p[1] - 200) <= tol
	        and abs(p[2] - 90) <= tol)
xs = [x for y in range(h) for x in range(w) if near(px[x, y])]
if not xs:
	if control is not None:
		seen = any(px[x, y] == control for y in range(h) for x in range(w))
		print("screen-check: FAILED -- nothing at all was drawn in %s"
		      % who if not seen else
		      "screen-check: FAILED -- %s drew its control and not its marker"
		      % who, file=sys.stderr)
	else:
		print("screen-check: FAILED -- the probe drew nothing in %s" % who,
		      file=sys.stderr)
	sys.exit(1)
left, width = min(xs), max(xs) - min(xs) + 1
# The slack is named rather than assumed, and it differs per terminal. In
# kitty it is one pixel: scaling to the cell uses a smooth transform, so
# the outermost column is blended and no longer matches exactly. In xterm
# it is the window's own inset, measured at 3 px on both axes and allowed
# 6 -- which still separates a 6 px cell from a 10 px one by a wide
# margin, the two predictions being 132 and 220. Both numbers are PRINTED,
# because a tolerance is only honest when the value inside it is visible.
ok = abs(left - want_l) <= slack and abs(width - want_w) <= slack
print("screen-check: %s drew left=%d width=%d, predicted %d and %d"
	% (who, left, width, want_l, want_w),
	file=sys.stderr if not ok else sys.stdout)
sys.exit(0 if ok else 1)
GEOM

		capture "$dir/geom.png" 0 \
		    "kitty sh -c 'sleep 2; QTTY_GRAPHICS=kitty $dir/probe 2>$dir/pred'"
		python3 "$dir/geom.py" "$dir/geom.png" "$dir/pred" 0 1 kitty

		# The KittyAlpha overlay, which is a THIRD function that transmits
		# an image and the last one with no picture of it. The probe draws a
		# blue control through the pixel path in the same frame, so a
		# missing overlay is told apart from a run that drew nothing -- the
		# distinction that cost three wrong readings when the cell-size
		# conversion was found missing here.
		capture "$dir/ov.png" 0 \
		    "kitty sh -c 'sleep 2; QTTY_GRAPHICS=kitty-alpha" \
		    "QTTY_SCREEN_PATH=overlay $dir/probe 2>$dir/opred'"
		python3 "$dir/geom.py" "$dir/ov.png" "$dir/opred" 0 1 overlay 60,90,220

		# A multiplexer between qtty and the terminal, which is a third
		# stack rather than a third tier: qtty inside tmux inside kitty.
		#
		# This one is the FALLBACK: tmux with no configuration does not
		# forward the capability query, so qtty gets no confirmation and
		# half-blocks are the honest answer. The phase below it turns
		# passthrough on and is the placeholder path.
		#
		# It was written as a placeholder test and was not one, which is
		# why the probe prints the tier it used: both modes put the marker
		# on the same cell, so nothing in the picture could have said so.
		#
		# What it checks is real and is checked nowhere else: that the
		# fallback inside a multiplexer still puts the picture on the right
		# cell. It cannot compare against the probe's prediction, because
		# tmux forwards no CSI 16t either and the probe therefore predicts
		# from its own font -- 220 and 40, where the picture lands at 198
		# and 36, kitty's real cell.
		#
		# So it asserts a RELATIONSHIP that needs no cell size: the marker
		# sits at cell 22 and is four cells wide, so its left edge over 22
		# and its width over 4 are the same number whatever that number is.
		if command -v tmux >/dev/null 2>&1; then
			# The socket lives in the scratch directory the trap
			# removes, rather than in tmux's shared one: a -L name
			# leaves a dead socket file behind after kill-server, and
			# a gate that litters /tmp on every run is a gate somebody
			# eventually has to sweep up after.
			sock=$dir/tmux.sock
			cat > "$dir/inner.sh" <<INNER
#!/bin/sh
sleep 2
tmux -S $sock -f /dev/null new-session -- \
    sh -c "QTTY_SCREEN_PATH=cells $dir/probe 2>$dir/tpred"
INNER
			chmod +x "$dir/inner.sh"
			cat > "$dir/cells.py" <<'CELLS'
import sys
from PIL import Image
im = Image.open(sys.argv[1]).convert("RGB")
w, h = im.size
px = im.load()
def near(p):
	return (abs(p[0] - 40) <= 6 and abs(p[1] - 200) <= 6
	        and abs(p[2] - 90) <= 6)
xs = [x for y in range(h) for x in range(w) if near(px[x, y])]
if not xs:
	print("screen-check: FAILED -- nothing was drawn through tmux",
	      file=sys.stderr)
	sys.exit(1)
left, width = min(xs), max(xs) - min(xs) + 1
# Cell 22, four cells wide. Both divisions give the terminal's cell width
# if the placement is right, and neither needs it to be known in advance.
by_left, by_width = left / 22.0, width / 4.0
ok = abs(by_left - by_width) <= 1.0
print("screen-check: through tmux drew left=%d width=%d, implying a cell of"
	" %.2f and %.2f" % (left, width, by_left, by_width),
	file=sys.stderr if not ok else sys.stdout)
sys.exit(0 if ok else 1)
CELLS
			capture "$dir/tmux.png" 6 "kitty $dir/inner.sh"
			tmux -S "$sock" kill-server >/dev/null 2>&1 || true
			python3 "$dir/cells.py" "$dir/tmux.png"

			# And the same stack with allow-passthrough on, which is what
			# lets the capability query reach the terminal underneath. That
			# is the configuration where the unicode-placeholder path
			# actually engages, and until the probe learned to ask twice it
			# never did anywhere: the backend probes once, the first attempt
			# inside tmux goes unanswered, so caps.kitty stayed false and
			# the mode that exists only for multiplexers was unreachable.
			#
			# The tier is asserted from the probe's own report rather than
			# from the picture, because half-blocks and placeholders put the
			# marker on the same cell -- which is exactly how the phase
			# above was written as a placeholder test and was not one.
			echo "set -g allow-passthrough on" > "$dir/tmux.conf"
			sock2=$dir/tmux2.sock
			cat > "$dir/inner2.sh" <<INNER2
#!/bin/sh
sleep 2
tmux -S $sock2 -f $dir/tmux.conf new-session -- \
    sh -c "QTTY_SCREEN_PATH=cells $dir/probe 2>$dir/ppred"
INNER2
			chmod +x "$dir/inner2.sh"
			capture "$dir/ph.png" 6 "kitty $dir/inner2.sh"
			tmux -S "$sock2" kill-server >/dev/null 2>&1 || true
			if grep -q "placeholders=yes" "$dir/ppred" 2>/dev/null; then
				echo "screen-check: with passthrough the placeholder path" \
				     "engages, and:"
				python3 "$dir/cells.py" "$dir/ph.png"
			else
				echo "screen-check: FAILED -- with allow-passthrough on the" >&2
				echo "              placeholder path did not engage:" >&2
				sed -n '1,2p' "$dir/ppred" >&2
				exit 1
			fi
		else
			echo "screen-check: tmux is absent, so the placeholder path was" >&2
			echo "              not drawn" >&2
		fi

		# xterm needs three things said out loud, all of them learned by
		# getting them wrong. -ti vt340 for sixel at all. allowWindowOps so
		# that CSI 16t is ANSWERED -- its default is off, and without it
		# qtty gets silence, falls back to its own font metrics and draws
		# at 10x19 where the terminal's cell is 6x13, so the scaling this
		# check exists for is never exercised. And no -fa/-fs: asking for a
		# TrueType font by name left xterm unable to start at all under
		# Xvfb, and a capture of 540000 black pixels reads exactly like a
		# renderer that drew nothing.
		if command -v xterm >/dev/null 2>&1; then
			capture "$dir/xterm.png" 4 \
			    "xterm -ti vt340 -geometry 90x30+0+0" \
			    "-xrm 'XTerm*allowWindowOps: true'" \
			    "-e sh -c 'sleep 2; QTTY_GRAPHICS=sixel $dir/probe 2>$dir/xpred'"
			python3 "$dir/geom.py" "$dir/xterm.png" "$dir/xpred" 4 6 xterm

			# And the tier a terminal with no graphics protocol falls
			# back to, which is reached through a different function.
			# present_pixels() serves the tiers that transmit an image
			# and returns without drawing on the others; halfblocks
			# composites a placement into CELLS inside present(). So the
			# probe drives the cell path here, and the first run of this
			# through present_pixels() drew nothing and looked exactly
			# like a broken renderer.
			capture "$dir/hb.png" -1 \
			    "xterm -geometry 90x30+0+0" \
			    "-xrm 'XTerm*allowWindowOps: true'" \
			    "-e sh -c 'sleep 2; QTTY_SCREEN_PATH=cells" \
			    "QTTY_GRAPHICS=halfblocks $dir/probe 2>$dir/hpred'"
			python3 "$dir/geom.py" "$dir/hb.png" "$dir/hpred" -1 6 halfblocks
		else
			echo "screen-check: xterm is absent, so the sixel tier was not" >&2
			echo "              drawn -- the kitty tier above still ran" >&2
		fi
	else
		echo "screen-check: the probe did not build, so the pixel path was" >&2
		sed -n '1,3p' "$dir/cc" >&2
		exit 1
	fi
else
	echo "screen-check: no built library, so qtty's own pixel path was not" >&2
	echo "              drawn -- the terminal check above still ran" >&2
fi

python3 - "$dir/out.png" "$w" "$h" <<'PY'
import sys
from PIL import Image
shot, w, h = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
im = Image.open(shot).convert("RGB")
want = (220, 30, 40)
n = sum(1 for p in im.getdata() if p == want)
# Both directions. "Some red is on screen" is satisfied by a terminal that
# scaled the image to the whole window, and "not the whole window" by one
# that drew nothing at all.
if n == w * h:
	print("screen-check: kitty drew the image at its own size, %d px" % n)
	sys.exit(0)
print("screen-check: FAILED -- %d px of the test colour, wanted %d (%dx%d)"
	% (n, w * h, w, h), file=sys.stderr)
sys.exit(1)
PY
